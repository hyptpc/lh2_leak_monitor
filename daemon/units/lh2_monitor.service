[Unit]
Description=LH2 leak monitor
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/misc/share /home/sks/.venv /home/sks/share/monitor-tools/lh2_leak_monitor

[Service]
Type=exec
User=sks
WorkingDirectory=/home/sks/share/monitor-tools/lh2_leak_monitor
ExecStartPre=/usr/bin/test -r /home/sks/share/monitor-tools/lh2_leak_monitor/monitor.py
ExecStartPre=/usr/bin/test -r /home/sks/share/monitor-tools/lh2_leak_monitor/config.toml
ExecStart=/home/sks/.venv/bin/python -u /home/sks/share/monitor-tools/lh2_leak_monitor/monitor.py --startup-alert wait
Restart=no
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=30
SuccessExitStatus=130
StandardOutput=journal
StandardError=journal
# Keep the operator's /tmp/skip.now, cancel.now, and extend.now visible.
PrivateTmp=no

[Install]
WantedBy=multi-user.target
